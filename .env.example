# Copiez ce fichier sous le nom ".env" et remplissez les valeurs. Ne publiez jamais le fichier .env.

# Chemin complet du dossier du projet sur le NAS (celui qui contient server.js)
APP_DIR=/srv/dev-disk-by-uuid-XXXX/appdata/stages

# Codes d'inscription : choisissez des codes longs, difficiles a deviner
CODE_PROF=
CODE_ELEVE=

# Jeton du tunnel, fourni par Cloudflare a la creation du tunnel
TUNNEL_TOKEN=
